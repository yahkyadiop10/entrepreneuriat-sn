---
// Étape d'un parcours (prototype « Page Parcours » · Étape). Réponses dans localStorage (D2).
import Base from '../layouts/Base.astro';
import Icone from '../components/Icone.astro';
import TexteGras from '../components/TexteGras.astro';
import '../styles/exercices.css';
import { CALCULS, CLE_NOTES, NOMBRES, PARCOURS, PERSO, UI, cle, type Bloc, type ParcoursId } from '../content/parcours';
import { COMMUN } from '../i18n/commun';
import { r, url, type Lang } from '../i18n/routes';

interface Props { lang: Lang; id: ParcoursId; n: number }
const { lang, id, n } = Astro.props;
const P = PARCOURS[lang][id];
const U = UI[lang];
const E = P.etapes[n - 1];
const total = P.etapes.length;
const nombres = NOMBRES[id] ?? [];
const calculs = CALCULS[id] ?? [];
const calculsEtape = calculs.filter((c) => c.etape === n);
// Calcul inséré à la place d'une ligne « Calcul automatique » (Activité) ou d'un champ (Entreprendre).
const calculLigne = calculsEtape.find((c) => !c.cible.startsWith(`s${n}_`) || /_[a-z]/.test(c.cible));
const calculChamp = (cid: string) => calculsEtape.find((c) => c.cible === cid);
const cles = id === 'competences' ? `${cle(id)} ${CLE_NOTES}` : cle(id);
const ref = { kind: 'etape', parcours: id, n } as const;
const precedent = n > 1 ? url({ kind: 'etape', parcours: id, n: n - 1 }, lang) : r(id, lang);
const suivant = n < total ? url({ kind: 'etape', parcours: id, n: n + 1 }, lang) : url({ kind: 'ma-fiche', parcours: id }, lang);
const blocs = (b: Bloc[]) => b;
---
<Base lang={lang} page={ref} titre={`${E.titre} · ${P.titre} | Entrepreneuriat Sénégal`} description={P.seoDescription}>
  <div class="bloc__in etape" data-cle={cle(id)} data-cles={cles} data-confirm={U.effacerConfirm} data-lang={lang}
    data-calculs={JSON.stringify(calculs.map(({ cible, plus, moins }) => ({ cible, plus, moins })))}>
    <nav aria-label={COMMUN[lang].filAriane} class="ariane">
      <ol>
        <li><a href={r('accueil', lang)}>{U.accueil}</a></li>
        <li><a href={r('etre-accompagne', lang)}>{U.etreAccompagne}</a></li>
        <li><a href={r(id, lang)}>{P.titre}</a></li>
        <li><span aria-current="page">{U.etapeN(n)}</span></li>
      </ol>
    </nav>

    <div class="etape__grille">
      <nav class="sommaire" aria-label={U.sommaire}>
        <p class="surtitre">{P.titre}</p>
        <ol>
          {P.etapes.map((e) => (
            <li><a href={url({ kind: 'etape', parcours: id, n: e.n }, lang)} aria-current={e.n === n ? 'step' : undefined}>
              <span class="sommaire__n">{e.n}</span><span>{e.titre}</span>
            </a></li>
          ))}
          <li><a href={url({ kind: 'ma-fiche', parcours: id }, lang)}><span class="sommaire__n"><Icone nom="ui-valide" taille={16} /></span><span>{U.maFiche}</span></a></li>
        </ol>
      </nav>

      <article class="etape__corps">
        <header class="colonne" style="gap:12px">
          <p class="surtitre">{U.progression(n, total)}</p>
          <div class="progression" role="progressbar" aria-valuemin="1" aria-valuemax={total} aria-valuenow={n} aria-label={U.progression(n, total)}>
            {P.etapes.map((e) => <span class:list={[e.n < n && 'fait', e.n === n && 'en-cours']}></span>)}
          </div>
          <h1>{E.titre}</h1>
        </header>

        <section class="colonne" style="gap:12px">
          <h2 class="filet-titre">{U.essentiel}</h2>
          {blocs(E.essentiel).map((b) =>
            b.p ? <p class="t18"><TexteGras t={b.p} /></p>
            : b.ol ? <ol class="liste t18">{b.ol.map((x) => <li><TexteGras t={x} /></li>)}</ol>
            : <ul class="liste t18">{b.ul!.map((x) => <li><TexteGras t={x} /></li>)}</ul>
          )}
        </section>

        <section class="exemple">
          <span class="exemple__pastille" aria-hidden="true">{PERSO[id][0]}</span>
          <div class="colonne" style="gap:8px">
            <h2>{E.exempleTitre}</h2>
            {blocs(E.exemple).map((b) =>
              b.p ? <p><TexteGras t={b.p} /></p>
              : b.ol ? <ol class="liste">{b.ol.map((x) => <li><TexteGras t={x} /></li>)}</ol>
              : <ul class="liste">{b.ul!.map((x) => <li><TexteGras t={x} /></li>)}</ul>
            )}
          </div>
        </section>

        <section class="colonne exercice" style="gap:16px">
          <h2 class="filet-titre">{U.exercice}{E.exercice}</h2>
          {E.exerciceNote && <p class="champ__aide">({E.exerciceNote})</p>}
          {E.champs.map((c) => {
            if (c.type === 'consigne') return <p class="t17"><TexteGras t={c.t} /></p>;
            if (c.type === 'calcul') {
              if (c.apres) return <p class="calcul-note">{c.label}</p>;
              const k = calculLigne;
              return k && (
                <div class="champ">
                  <span class="champ__label" id={`l-${k.cible}`}>{c.label}</span>
                  <output class="champ__calcul" data-calcul={k.cible} aria-labelledby={`l-${k.cible}`} aria-live="polite">—</output>
                </div>
              );
            }
            if (c.type === 'cases') return (
              <fieldset class="cases" data-max={c.max}>
                <legend class="champ__label">{c.label}</legend>
                <div class="cases__liste">
                  {c.options.map((o) => <label><input type="checkbox" name={c.id} value={o} /><span>{o}</span></label>)}
                </div>
              </fieldset>
            );
            const k = calculChamp(c.id);
            if (k) return (
              <div class="champ">
                <span class="champ__label" id={`l-${c.id}`}>{c.label}</span>
                <output class="champ__calcul" data-calcul={c.id} aria-labelledby={`l-${c.id}`} aria-live="polite">—</output>
              </div>
            );
            return (
              <label class="champ">
                <span class="champ__label">{c.label}</span>
                {c.hint && <span class="champ__aide">{c.hint}</span>}
                {nombres.includes(c.id)
                  ? <span class="champ__nombre"><input type="text" inputmode="numeric" autocomplete="off" name={c.id} /><span aria-hidden="true">{U.fcfa}</span></span>
                  : <textarea name={c.id} rows="2"></textarea>}
              </label>
            );
          })}
          <div class="exercice__pied">
            <p class="enregistre"><Icone nom="ui-valide" taille={16} />{U.enregistre}</p>
            <button type="button" class="effacer">{U.effacer}</button>
          </div>
        </section>

        <div class="mon-action">
          <h2 class="surtitre">{U.action}</h2>
          <p><TexteGras t={E.action} /></p>
        </div>

        <nav class="etape__nav" aria-label={U.sommaire}>
          <a class="bouton bouton--secondaire" href={precedent}><span aria-hidden="true">←</span><span>{n > 1 ? U.precedent : P.titre}</span></a>
          <a class="bouton bouton--principal" href={suivant}><span>{n < total ? U.suivant : U.terminer}</span><span aria-hidden="true">→</span></a>
        </nav>
      </article>
    </div>
  </div>
</Base>

<script>
  import { initEtape } from '../scripts/parcours';
  document.querySelectorAll<HTMLElement>('.etape').forEach(initEtape);
</script>

<style>
  .etape { display: flex; flex-direction: column; gap: 24px; padding-top: clamp(24px, 3.4vw, 48px); padding-bottom: clamp(48px, 6vw, 96px); }
  .etape__grille { display: grid; grid-template-columns: 1fr; gap: 40px; }
  .etape__corps { display: flex; flex-direction: column; gap: 28px; max-width: 760px; min-width: 0; }
  .etape__corps h1 { text-wrap: balance; }
  .surtitre { font-family: var(--f-texte); font-size: 13px; letter-spacing: 0.1em; }

  .sommaire { display: none; }
  @media (min-width: 1024px) {
    .etape__grille { grid-template-columns: 260px 1fr; gap: clamp(40px, 5vw, 80px); }
    .sommaire { display: flex; flex-direction: column; gap: 10px; position: sticky; top: 96px; align-self: start; }
  }
  .sommaire ol { list-style: none; margin: 0; padding: 0; border-top: var(--filet-fin); }
  .sommaire a { display: grid; grid-template-columns: 24px 1fr; gap: 8px; padding: 10px 8px; border-bottom: var(--filet-fin); font-size: 15px; line-height: 1.35; color: var(--encre); text-decoration: none; }
  .sommaire a:hover span:last-child { text-decoration: underline; }
  .sommaire a[aria-current] { background: var(--jaune-clair); font-weight: 600; }
  .sommaire__n { font-family: var(--f-titre); font-weight: 700; color: var(--vert); display: flex; align-items: center; }

  .progression { display: flex; gap: 4px; }
  .progression span { flex: 1; height: 8px; background: var(--bordure); }
  .progression .fait { background: var(--vert); }
  .progression .en-cours { background: var(--jaune); }

  .exemple { background: var(--vert-clair); padding: 18px 16px; display: grid; grid-template-columns: 56px 1fr; gap: 16px; align-items: start; }
  .exemple__pastille { width: 56px; height: 56px; border-radius: 50%; background: var(--vert); color: var(--blanc); display: grid; place-items: center; font-family: var(--f-titre); font-weight: 700; font-size: 26px; }
  .exemple h2 { font-size: 19px; letter-spacing: 0; }
  .exemple p, .exemple li { font-size: 17px; line-height: 1.55; }
  @media (max-width: 480px) {
    .exemple { grid-template-columns: 1fr; }
    .exemple__pastille { width: 44px; height: 44px; font-size: 20px; }
  }

  .etape__nav { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 10px; border-top: var(--filet); padding-top: 20px; }
  .etape__nav .bouton { flex: 0 1 auto; }
  @media (max-width: 480px) { .etape__nav .bouton { flex: 1 1 100%; } }
</style>
