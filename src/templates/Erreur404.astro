---
import Base from '../layouts/Base.astro';
import Bouton from '../components/Bouton.astro';
import { COMMUN } from '../i18n/commun';
import { r, type Lang } from '../i18n/routes';

interface Props { lang: Lang }
const { lang } = Astro.props;
const C = COMMUN[lang];
---
<Base lang={lang} page={{ kind: '404' }} titre={`${C.nf.titre} · Entrepreneuriat Sénégal`} description={C.nf.titre}>
  <section class="nf conteneur">
    <div class="nf__code" aria-hidden="true">404</div>
    <h1>{C.nf.titre}</h1>
    <div class="nf__boutons">
      <Bouton href={r('accueil', lang)}>{C.nf.accueil}</Bouton>
      <Bouton href={r('etre-accompagne', lang)} variante="secondaire">{C.nf.parcours}</Bouton>
    </div>
  </section>
</Base>

<style>
  .nf { padding-block: clamp(48px, 7vw, 120px); display: flex; flex-direction: column; gap: 24px; max-width: 1200px; }
  .nf__code { font-family: var(--f-titre); font-weight: 700; font-size: clamp(72px, 10vw, 160px); line-height: 0.9; color: var(--vert); }
  .nf__boutons { display: flex; flex-wrap: wrap; gap: 12px; }
  .nf__boutons :global(.bouton) { min-width: 240px; }
</style>
