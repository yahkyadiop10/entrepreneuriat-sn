---
// Page provisoire du lot 1 (socle). Remplacée par le gabarit Accueil au lot 2.
import Base from '../layouts/Base.astro';
import Bouton from '../components/Bouton.astro';
import Photo from '../components/Photo.astro';
import Icone from '../components/Icone.astro';
import FilAriane from '../components/FilAriane.astro';

const icones = ['pole-entrepreneuriat', 'pole-soft-skills', 'pole-employabilite', 'pole-ingenierie', 'pole-conseil'];
---
<Base lang="fr" page={{ kind: 'route', id: 'accueil' }} titre="Entrepreneuriat Sénégal · Accompagnement et formation" description="Socle du site : couleurs, polices, composants." indexer={false}>
  <FilAriane lang="fr" items={[{ label: 'Accueil', href: '/' }, { label: 'Socle' }]} />
  <section class="section conteneur pile" style="--pile: 24px">
    <p class="surtitre">Lot 1 · socle</p>
    <h1>Révéler les potentiels, développer les <span class="surligne">compétences</span></h1>
    <p class="chapeau texte">Cette page provisoire montre le socle : couleurs, polices, boutons, icônes et emplacements de photos. Elle sera remplacée par l'accueil au lot 2.</p>
    <div style="display:flex;flex-wrap:wrap;gap:12px">
      <Bouton href="/etre-accompagne/">Principal</Bouton>
      <Bouton href="/organisations/" variante="secondaire">Secondaire</Bouton>
      <Bouton href="/ressources/" variante="lien" fleche={false}>Lien-bouton</Bouton>
    </div>
  </section>
  <section class="section conteneur">
    <h2>Les 5 pôles</h2>
    <ul style="list-style:none;padding:0;margin:24px 0 0;display:flex;gap:16px;flex-wrap:wrap">
      {icones.map((n) => <li style="width:52px;height:52px;display:grid;place-items:center;background:var(--vert-clair);color:var(--vert)"><Icone nom={n} /></li>)}
    </ul>
  </section>
  <section class="section conteneur grille-2">
    <Photo lang="fr" fichier="accueil-banniere.jpg" alt="Une jeune entrepreneure dans son atelier" legende="jeune entrepreneure dans son atelier" ratio="4/3" />
    <div style="background:var(--jaune);padding:32px" class="pile">
      <h2>Fond jaune</h2>
      <Bouton href="/contact/" variante="sur-jaune">Bouton sur fond jaune</Bouton>
    </div>
  </section>
</Base>
