---
// Icônes Lucide retravaillées (passation Claude Design), intégrées en SVG en ligne avec currentColor.
const fichiers = import.meta.glob<string>('../assets/icones/*.svg', { query: '?raw', import: 'default', eager: true });

interface Props {
  nom: string;
  taille?: number;
  class?: string;
  label?: string;
}
const { nom, taille = 24, class: classe, label } = Astro.props;
const brut = fichiers[`../assets/icones/${nom}.svg`];
if (!brut) throw new Error(`Icône inconnue : ${nom}`);
const ouverture = brut.match(/<svg[^>]*>/)?.[0] ?? '';
const plein = /fill="currentColor"/.test(ouverture); // icônes de réseaux : formes pleines
const interieur = brut.replace(/^[\s\S]*?<svg[^>]*>/, '').replace(/<\/svg>\s*$/, '').replace(/<title>[\s\S]*?<\/title>/, '');
---
<svg
  xmlns="http://www.w3.org/2000/svg"
  width={taille}
  height={taille}
  viewBox="0 0 24 24"
  fill={plein ? 'currentColor' : 'none'}
  stroke={plein ? 'none' : 'currentColor'}
  stroke-width={plein ? undefined : 2}
  stroke-linecap="round"
  stroke-linejoin="round"
  class={classe}
  role={label ? 'img' : undefined}
  aria-label={label}
  aria-hidden={label ? undefined : 'true'}
  focusable="false"
  set:html={interieur}
/>
