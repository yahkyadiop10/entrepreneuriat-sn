# entrepreneuriat.sn — hébergement mutualisé LWS (Apache)
Options -Indexes
DirectorySlash On

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Une seule adresse officielle : https://entrepreneuriat.sn (D8)
  RewriteCond %{HTTP_HOST} ^www\.entrepreneuriat\.sn$ [NC]
  RewriteRule ^ https://entrepreneuriat.sn%{REQUEST_URI} [R=301,L]
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !=https
  RewriteRule ^ https://entrepreneuriat.sn%{REQUEST_URI} [R=301,L]

</IfModule>

ErrorDocument 404 /404.html
<If "%{REQUEST_URI} =~ m#^/en/#">
  ErrorDocument 404 /en/404/index.html
</If>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
  <FilesMatch "\.(css|js|woff2?|svg|png|jpe?g|webp)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.html$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript image/svg+xml
</IfModule>
