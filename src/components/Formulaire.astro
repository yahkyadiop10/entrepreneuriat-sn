---
// Formulaire de contact ou de demande de partenariat (lot 5). Vérifié dans le navigateur, puis envoyé
// à /api/envoyer.php (PHP sur LWS), qui vérifie à nouveau, enregistre dans Neon et prévient l'équipe par e-mail.
import Icone from './Icone.astro';
import '../styles/exercices.css';
import { ADRESSE_ENVOI, FORMULAIRES } from '../config';
import { CONTACT_CHAMPS, OBJETS_PARTENARIAT, PARTENARIAT_BLOCS, TEXTES, type Champ } from '../content/formulaires';
import { r, type Lang } from '../i18n/routes';

interface Props { lang: Lang; type: 'contact' | 'partenariat' }
const { lang, type } = Astro.props;
const T = TEXTES[lang];
const F = type === 'contact' ? T.contact : T.partenariat;
const blocs = type === 'contact' ? [{ titre: null, champs: CONTACT_CHAMPS }] : PARTENARIAT_BLOCS.map((b) => ({ titre: b.titre[lang], champs: b.champs }));
const messages = {
  requis: T.requis, email: F.email, fichier: type === 'partenariat' ? T.partenariat.fichier : '',
  echec: F.echec, envoi: T.envoi, apercuEnvoi: T.apercuEnvoi,
};
const decrit = (c: Champ) => [c.aide && `a-${type}-${c.id}`, c.max && `n-${type}-${c.id}`, `e-${type}-${c.id}`].filter(Boolean).join(' ');
const nb = (n: number) => n.toLocaleString(lang === 'fr' ? 'fr-FR' : 'en-GB').replace(/ /g, ' ');
---
<div class="formulaire" data-etat={FORMULAIRES}>
  {FORMULAIRES === 'apercu' && <p class="apercu" role="note">{T.apercu}</p>}
  <form method="post" action={ADRESSE_ENVOI} enctype="multipart/form-data" novalidate
    data-type={type} data-lang={lang} data-etat={FORMULAIRES} data-messages={JSON.stringify(messages)}>
    <input type="hidden" name="formulaire" value={type} />
    <input type="hidden" name="langue" value={lang} />
    <input type="hidden" name="debut" value="" />
    <div class="pot" aria-hidden="true">
      <label>Site web <input type="text" name="site_web" tabindex="-1" autocomplete="off" /></label>
    </div>

    {blocs.map((b) => (
      <fieldset class="bloc-form">
        {b.titre && <legend class="bloc-form__titre">{b.titre}</legend>}
        {b.champs.map((c) => {
          const label = <>{c.label[lang]}{c.req && <span class="requis" aria-hidden="true"> *</span>}</>;
          const commun = { id: `${type}-${c.id}`, name: c.id, 'aria-describedby': decrit(c), 'data-requis': c.req ? '' : undefined };
          if (c.type === 'cases') return (
            <fieldset class="champ cases" id={`${type}-${c.id}`} data-requis={c.req ? '' : undefined} data-nom={c.id} aria-describedby={`e-${type}-${c.id}`}>
              <legend class="champ__label">{label}</legend>
              <div class="cases__liste">
                {c.options!.map((o) => <label><input type="checkbox" name={`${c.id}[]`} value={o.v} /><span>{o[lang]}</span></label>)}
              </div>
              <p class="erreur" id={`e-${type}-${c.id}`} hidden></p>
            </fieldset>
          );
          return (
            <div class="champ" data-champ={c.id}>
              <label class="champ__label" for={`${type}-${c.id}`}>{label}</label>
              {c.aide && <span class="champ__aide" id={`a-${type}-${c.id}`}>{c.aide[lang]}</span>}
              {c.type === 'select' ? (
                <select {...commun}>
                  <option value="">{T.choisir}</option>
                  {c.options!.map((o) => <option value={o.v}>{o[lang]}</option>)}
                </select>
              ) : c.type === 'textarea' ? (
                <textarea {...commun} rows="6" maxlength={c.max}></textarea>
              ) : c.type === 'fichier' ? (
                <input {...commun} type="file" accept=".pdf,.doc,.docx,application/pdf,application/msword,application/vnd.openxmlformats-officedocument.wordprocessingml.document" />
              ) : (
                <input {...commun} type={c.type} autocomplete={c.autocomplete} inputmode={c.type === 'tel' ? 'tel' : undefined} />
              )}
              {c.max && <span class="champ__compteur" id={`n-${type}-${c.id}`} data-max={c.max}><span>0</span> / {nb(c.max)} {T.caracteres}</span>}
              <p class="erreur" id={`e-${type}-${c.id}`} hidden></p>
              {type === 'contact' && c.id === 'objet' && (
                <p class="renvoi" hidden data-objets={JSON.stringify(OBJETS_PARTENARIAT)}>
                  <a href={r('partenariat', lang)}>{T.contact.renvoi}</a>
                </p>
              )}
            </div>
          );
        })}
      </fieldset>
    ))}

    <div class="champ consentement">
      <label class="case-seule">
        <input type="checkbox" name="consentement" value="oui" id={`${type}-consentement`} data-requis aria-describedby={`e-${type}-consentement`} />
        <span>{F.consentement}<span class="requis" aria-hidden="true"> *</span></span>
      </label>
      <p class="consentement__lien">
        {type === 'partenariat' && <em>{T.partenariat.enSavoirPlus}</em>}<a href={r('confidentialite', lang)}>{T.politique}</a>
      </p>
      <p class="erreur" id={`e-${type}-consentement`} hidden></p>
    </div>

    <p class="echec encadre" role="alert" hidden></p>
    <button type="submit" class="bouton bouton--principal"><span>{F.bouton}</span><span aria-hidden="true">→</span></button>
  </form>

  <div class="merci" hidden tabindex="-1">
    <Icone nom="ui-valide" taille={32} />
    {type === 'partenariat' ? (
      <>
        <h2>{T.partenariat.merciTitre}</h2>
        <p>{T.partenariat.merci}</p>
        <p><a class="bouton bouton--secondaire" href={r('accueil', lang)}>{T.partenariat.retour}</a></p>
      </>
    ) : <p class="merci__texte">{T.contact.merci}</p>}
  </div>
</div>

<script>
  import { initFormulaire } from '../scripts/formulaire';
  document.querySelectorAll<HTMLFormElement>('.formulaire form').forEach(initFormulaire);
</script>

<style>
  .formulaire { display: flex; flex-direction: column; gap: 20px; }
  form { display: flex; flex-direction: column; gap: 24px; }
  .apercu { background: var(--encre); color: var(--blanc); padding: 12px 16px; font-size: 15px; }
  .pot { position: absolute; left: -9999px; width: 1px; height: 1px; overflow: hidden; }
  .bloc-form { border: 0; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 18px; }
  .bloc-form__titre { font-family: var(--f-titre); font-weight: 700; font-size: 22px; padding: 0 0 8px; margin-bottom: 4px; width: 100%; border-bottom: var(--filet); }
  .requis { color: var(--rouge); }
  input[type=text], input[type=email], input[type=tel], select, .champ textarea {
    font: inherit; font-size: 17px; line-height: 1.4; padding: 10px 12px; background: var(--blanc); width: 100%;
    border: 1px solid var(--bordure); border-radius: 0; color: var(--encre); min-height: 48px;
  }
  select { appearance: auto; }
  input[type=file] { font: inherit; font-size: 16px; padding: 10px 0; }
  input:focus-visible, select:focus-visible, .champ textarea:focus-visible { border-color: var(--vert); outline: 2px solid var(--vert); outline-offset: 0; }
  [aria-invalid=true] { border-color: var(--rouge) !important; }
  .cases[aria-invalid=true] .cases__liste label { border-color: var(--rouge); }
  .champ__compteur { font-size: 14px; color: var(--secondaire); align-self: flex-end; }
  .champ__compteur.plein { color: var(--rouge); }
  .erreur { color: var(--rouge); font-size: 15px; font-weight: 600; display: flex; gap: 6px; }
  .renvoi { font-size: 15px; background: var(--jaune-clair); padding: 10px 12px; }
  .renvoi a { color: var(--vert); font-weight: 600; text-decoration: underline; text-underline-offset: 3px; }
  .case-seule { display: flex; gap: 12px; align-items: flex-start; font-size: 16px; line-height: 1.45; cursor: pointer; }
  .case-seule input { width: 22px; height: 22px; flex: none; margin: 1px 0 0; accent-color: var(--vert); }
  .consentement__lien { font-size: 15px; padding-left: 34px; }
  .consentement__lien a { color: var(--vert); text-decoration: underline; text-underline-offset: 3px; }
  .echec { background: #FBE9EA; border-left: 4px solid var(--rouge); padding: 12px 16px; font-size: 16px; margin: 0; }
  form button[type=submit] { align-self: flex-start; }
  form button[disabled] { opacity: .6; cursor: progress; }
  .merci { background: var(--vert-clair); padding: 24px 20px; display: flex; flex-direction: column; gap: 12px; color: var(--encre); }
  .merci :global(svg) { color: var(--vert); }
  .merci h2 { font-size: clamp(24px, 2.4vw, 32px); }
  .merci p, .merci__texte { font-size: 18px; line-height: 1.5; }
</style>
