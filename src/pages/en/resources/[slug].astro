---
import Fiche from '../../../templates/Fiche.astro';
import { FICHES, type FicheId } from '../../../i18n/routes';
export function getStaticPaths() {
  return Object.entries(FICHES).map(([id, s]) => ({ params: { slug: s.en }, props: { id: id as FicheId } }));
}
const { id } = Astro.props;
---
<Fiche lang="en" id={id} />
